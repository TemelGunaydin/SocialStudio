# Copy to .env and replace values. Never commit .env.
ADMIN_PASSWORD=change-this-to-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2
# OAuth 2.0 Client ID ve Client Secret. API Key ve API Secret degildir.
X_CLIENT_ID=
X_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
# Listen address. For direct Tailscale access use the Mac's Tailscale IPv4.
HOST=127.0.0.1
DATA_DIR=./data
# Drafts are created at this hour in Europe/Istanbul.
DRAFT_HOUR=10
# New installs: opt in to paid daily AI drafts in the setup wizard.
SCHEDULE_ENABLED=false
